# Settings for the gateway and java_broker. Copy to .env (never committed)
# and fill in. Production, local and development.yml read .env from the repo
# root. The dev deploy job writes .env from the secrets of the `development`
# GitHub environment, one secret per key below; a key whose secret is unset
# gets the value written here, and keys empty here (except GATEWAY_*) must be set.
#
# Write values unquoted: `docker stack deploy` keeps quotes as part of the value.

# Main Postgres (gateway)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ActiveMQ source (java_broker)
ACTIVEMQ_BROKER_URL=
MQTT_IP_ADDRESS=
MQTT_PORT=
MQTT_USER=
MQTT_PASSWORD=
MQTT_FLIGHT_MOVEMENT_QUEUE=
MQTT_IDEP_QUEUE=
MQTT_SURV_TOPIC=

# Kafka (both)
KAFKA_BROKERS=localhost:9099
KAFKA_GROUP_ID=itafm-go-gateway
KAFKA_CLIENT_ID=itafm-amq-kafka-broker
KAFKA_FLIGHT_TOPIC=itafm.flight_movement
KAFKA_IDEP_TOPIC=itafm.idep
KAFKA_SURV_TOPIC=itafm.surveillance

# Gateway
SURVEILLANCE_DB_BATCH_INTERVAL=10s
SURVEILLANCE_DB_BATCH_MAX_SIZE=500
# Optional. Comma-separated X-API-Key values; empty turns the position API off.
# Generate one with: openssl rand -hex 32
GATEWAY_SURVEILLANCE_API_KEYS=
# Optional. Monitor login; empty keeps the built-in defaults.
GATEWAY_MONITOR_USERNAME=
GATEWAY_MONITOR_PASSWORD=
